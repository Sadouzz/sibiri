datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  projects  Project[]
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  images      String[]
  date        DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
